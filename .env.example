# StudyHub — LOCAL DEVELOPMENT ONLY.
# Copy to .env (`Copy-Item .env.example .env`). .env is git-ignored and must never be committed.
# The values below are throwaway local placeholders; the API refuses to start in production
# if any credential still contains "change-me".

NODE_ENV=development
LOG_LEVEL=info
APP_VERSION=0.1.0-dev

# API
API_HOST=127.0.0.1
API_PORT=4000
READINESS_TIMEOUT_MS=2000
# Addresses allowed to set X-Forwarded-Host (reverse proxy and web server). Comma-separated IPs/CIDRs.
TRUSTED_PROXIES=127.0.0.1,::1

# Identity (M4). 32-byte key (base64) for secrets at rest (TOTP secrets, links in queued emails).
# Leave unset locally to use the public development key; production refuses that key.
# IDENTITY_ENCRYPTION_KEY=
# Links in emails point at the school's host: http://{host}:3000 locally, https://{host} in production.
SCHOOL_URL_TEMPLATE=http://{host}:3000
# Schools created in the console get {slug}.<this domain> (M9). Locally *.localhost resolves to 127.0.0.1.
SCHOOL_HOST_SUFFIX=localhost

# Email (local: Mailpit from docker compose catches everything; UI at http://127.0.0.1:8025)
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM_ADDRESS=no-reply@mail.studyhub.localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Object storage (M5). Local: SeaweedFS from docker compose (S3 API on 127.0.0.1:8333); production: Cloudflare R2.
# The local keys match infra/seaweedfs/s3.json; production refuses them and S3_CREATE_BUCKET=true.
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=studyhub-local
S3_ACCESS_KEY_ID=studyhub-local
S3_SECRET_ACCESS_KEY=studyhub-local-object-store
S3_CREATE_BUCKET=true
OBJECT_STORE_PORT=8333
# Malware scanning: eicar-only (development: flags only the EICAR test file) or clamd (production).
MALWARE_SCANNER=eicar-only
# Video: only the development fake exists until a provider is approved (production refuses it).
VIDEO_PROVIDER=fake
# Storage per school until plans exist (M9).
DEFAULT_STORAGE_QUOTA_MB=10240

# Payments (M8). Only the development fake provider exists until one is approved (Q-PAY-3); production
# refuses it. Key-encryption key (32 bytes, base64) for school payment credentials and payer numbers:
# leave unset locally to use the public development key; production refuses that key.
PAYMENT_PROVIDERS=fake
# PAYMENT_ENCRYPTION_KEY=

# Web (server-side calls to the API)
API_INTERNAL_URL=http://127.0.0.1:4000
# Hosts that show the platform status page; every other host is a school site (read at web build time).
# Local school sites from `pnpm db:seed`: http://acme.localhost:3000 and http://beta.localhost:3000
PLATFORM_HOSTS=localhost,127.0.0.1
# Hosts that serve the platform console (read at web build time). Local: http://console.localhost:3000
CONSOLE_HOSTS=console.localhost
# on = every page shows the maintenance page (S-X04) with 503; the API keeps running.
MAINTENANCE_MODE=off

# PostgreSQL (docker compose, bound to localhost only)
POSTGRES_PORT=5432
POSTGRES_DB=studyhub
POSTGRES_SUPERUSER_PASSWORD=change-me-local-superuser
STUDYHUB_MIGRATOR_PASSWORD=change-me-local-migrator
STUDYHUB_APP_PASSWORD=change-me-local-app

# Connection strings used by the apps (must match the passwords above)
DATABASE_URL_MIGRATOR=postgresql://studyhub_migrator:change-me-local-migrator@127.0.0.1:5432/studyhub
DATABASE_URL_APP=postgresql://studyhub_app:change-me-local-app@127.0.0.1:5432/studyhub
