{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "StudyHub API",
    "version": "0.1.0",
    "description": "Operational probes (root) and tenant-scoped endpoints (/api/v1). The school is resolved only from the request host. Every error response is RFC 9457 problem+json."
  },
  "tags": [
    {
      "name": "operations",
      "description": "Liveness and readiness probes"
    },
    {
      "name": "tenancy",
      "description": "School context resolved from the request host"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealthz",
        "tags": [
          "operations"
        ],
        "summary": "Liveness: the API process is running",
        "responses": {
          "200": {
            "description": "The process is alive.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Healthz"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getReadyz",
        "tags": [
          "operations"
        ],
        "summary": "Readiness: required dependencies (database) are reachable",
        "responses": {
          "200": {
            "description": "Ready to serve traffic.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readyz"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable. The problem carries a `checks` extension member.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tenant": {
      "get": {
        "operationId": "getTenantBootstrap",
        "tags": [
          "tenancy"
        ],
        "summary": "The school resolved from the request host (never from a client-supplied id)",
        "responses": {
          "200": {
            "description": "The current school.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantBootstrap"
                }
              }
            }
          },
          "404": {
            "description": "Unknown, unverified or deleted host. Generic: never names a school (TENANT_NOT_FOUND).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Healthz": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "service": {
            "type": "string",
            "const": "studyhub-api"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "uptimeSeconds": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "uptimeSeconds"
        ],
        "additionalProperties": false
      },
      "Readyz": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "string",
                "const": "ok"
              }
            },
            "required": [
              "database"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "status",
          "version",
          "checks"
        ],
        "additionalProperties": false
      },
      "ReadinessChecks": {
        "type": "object",
        "properties": {
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          }
        },
        "required": [
          "database"
        ],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_FAILED",
              "NOT_FOUND",
              "INTERNAL",
              "SERVICE_UNAVAILABLE",
              "RATE_LIMITED",
              "TENANT_NOT_FOUND",
              "TENANT_CONTEXT_MISSING",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "VERSION_CONFLICT",
              "FEATURE_NOT_ENABLED",
              "LIMIT_REACHED",
              "SLUG_TAKEN",
              "SLUG_RESERVED",
              "ENROLMENT_INACTIVE",
              "ALREADY_ENROLLED",
              "ATTEMPT_CLOSED",
              "ATTEMPT_LIMIT_REACHED",
              "PAYMENT_PROVIDER_UNAVAILABLE",
              "PAYMENT_METHOD_NOT_SUPPORTED"
            ]
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "requestId": {
            "type": "string",
            "minLength": 1
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1
                },
                "code": {
                  "type": "string",
                  "minLength": 1
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "field",
                "code",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code",
          "requestId"
        ],
        "additionalProperties": {}
      },
      "TenantBootstrap": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "slug": {
            "type": "string",
            "minLength": 3,
            "maxLength": 30
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          },
          "status": {
            "type": "string",
            "enum": [
              "PROVISIONING",
              "ACTIVE",
              "SUSPENDED",
              "OFFBOARDING",
              "DELETED"
            ]
          },
          "branding": {
            "type": "object",
            "properties": {
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "displayName": {
                "type": "string",
                "minLength": 2,
                "maxLength": 120
              },
              "accentHex": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^#[0-9a-f]{6}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "fontPreset": {
                "type": "string",
                "enum": [
                  "COPPERLINE",
                  "HUMANIST",
                  "GEOMETRIC"
                ]
              },
              "showPoweredBy": {
                "type": "boolean"
              },
              "terminology": {
                "type": "object",
                "properties": {
                  "instructor": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  },
                  "instructors": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  },
                  "course": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  },
                  "courses": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "version",
              "displayName",
              "accentHex",
              "fontPreset",
              "showPoweredBy",
              "terminology"
            ],
            "additionalProperties": false
          },
          "locales": {
            "type": "object",
            "properties": {
              "defaultLocale": {
                "type": "string",
                "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
              },
              "enabledLocales": {
                "minItems": 1,
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
                }
              },
              "timeZone": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "required": [
              "defaultLocale",
              "enabledLocales",
              "timeZone"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "status",
          "branding",
          "locales"
        ],
        "additionalProperties": false
      }
    }
  }
}
