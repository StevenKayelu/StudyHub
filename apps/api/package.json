{
  "name": "@studyhub/api",
  "version": "0.1.0",
  "private": true,
  "description": "StudyHub API (NestJS on Fastify) and background worker",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api,worker -c gray,cyan,magenta \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --env-file-if-exists=../../.env --watch-path=dist dist/main.js\" \"node --env-file-if-exists=../../.env --watch-path=dist dist/worker.js\"",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "start:worker": "node --env-file-if-exists=../../.env dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:int": "vitest run --config vitest.integration.config.mts",
    "db:generate": "prisma generate",
    "db:migrate": "node --env-file-if-exists=../../.env dist/cli/migrate.js",
    "db:seed": "node --env-file-if-exists=../../.env dist/cli/seed.js",
    "tenant:create": "node --env-file-if-exists=../../.env dist/cli/tenant-create.js"
  },
  "devDependencies": {
    "@studyhub/config": "workspace:*",
    "@swc/core": "1.16.13",
    "@testcontainers/postgresql": "12.2.0",
    "@types/pg": "8.23.1",
    "concurrently": "10.0.6",
    "prisma": "7.10.0",
    "testcontainers": "12.2.0",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@studyhub/contracts": "workspace:*",
    "fastify": "5.12.5",
    "pg": "8.23.1",
    "pg-boss": "12.37.1",
    "pino": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  }
}
