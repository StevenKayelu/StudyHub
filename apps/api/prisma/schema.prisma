// ---------------------------------------------------------------------------------------------
// M6 learning (migration 0006): enrolments and lesson progress
// ---------------------------------------------------------------------------------------------

enum EnrollmentSource {
  FREE
  PURCHASE
  ADMIN_GRANT
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Enrollment {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String           @map("tenant_id") @db.Uuid
  membershipId       String           @map("membership_id") @db.Uuid
  courseId           String           @map("course_id") @db.Uuid
  source             EnrollmentSource
  orderItemId        String?          @map("order_item_id") @db.Uuid
  status             EnrollmentStatus @default(ACTIVE)
  startedAt          DateTime         @default(now()) @map("started_at") @db.Timestamptz(3)
  expiresAt          DateTime?        @map("expires_at") @db.Timestamptz(3)
  revokedAt          DateTime?        @map("revoked_at") @db.Timestamptz(3)
  revokeReason       String?          @map("revoke_reason")
  grantedBy          String?          @map("granted_by") @db.Uuid
  grantReason        String?          @map("grant_reason")
  progressPercent    Int              @default(0) @map("progress_percent") @db.SmallInt
  completedAt        DateTime?        @map("completed_at") @db.Timestamptz(3)
  // FK with ON DELETE SET NULL (last_lesson_id) in SQL; no Prisma relation (composite key).
  lastLessonId       String?          @map("last_lesson_id") @db.Uuid
  lastAccessedAt     DateTime?        @map("last_accessed_at") @db.Timestamptz(3)
  updatedAt          DateTime         @default(now()) @map("updated_at") @db.Timestamptz(3)
  /// Deposit plan: the share of lessons open now (null = all) and what was agreed at deposit time.
  accessLimitPct     Int?             @map("access_limit_pct") @db.SmallInt
  planLessonPct      Int?             @map("plan_lesson_pct") @db.SmallInt
  balanceMinor       BigInt?          @map("balance_minor")
  balanceDueAt       DateTime?        @map("balance_due_at") @db.Timestamptz(3)
  // FK to order_item (composite key) in SQL; no Prisma relation.
  balanceOrderItemId String?          @map("balance_order_item_id") @db.Uuid

  membership TenantMembership @relation(fields: [tenantId, membershipId], references: [tenantId, id], onDelete: Restrict)
  course     Course           @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Restrict)
  progress   LessonProgress[]

  @@unique([tenantId, id], map: "enrollment_tenant_id_id_key")
  @@index([tenantId, courseId, status], map: "enrollment_tenant_course_status_idx")
  @@map("enrollment")
}

model LessonProgress {
  tenantId        String               @map("tenant_id") @db.Uuid
  enrollmentId    String               @map("enrollment_id") @db.Uuid
  lessonId        String               @map("lesson_id") @db.Uuid
  status          LessonProgressStatus @default(IN_PROGRESS)
  positionSeconds Int                  @default(0) @map("position_seconds")
  completedAt     DateTime?            @map("completed_at") @db.Timestamptz(3)
  updatedAt       DateTime             @default(now()) @map("updated_at") @db.Timestamptz(3)

  enrollment Enrollment @relation(fields: [tenantId, enrollmentId], references: [tenantId, id], onDelete: Cascade)
  lesson     Lesson     @relation(fields: [tenantId, lessonId], references: [tenantId, id], onDelete: Cascade)

  @@id([tenantId, enrollmentId, lessonId])
  @@index([tenantId, lessonId], map: "lesson_progress_tenant_lesson_idx")
  @@map("lesson_progress")
}

