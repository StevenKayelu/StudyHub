enum PeriodKind {
  TERM
  SEMESTER
  SEMINAR
}

enum PeriodMode {
  AUTO
  OPEN
  LOCKED
}

enum CourseAccessOverride {
  OPEN
  LOCKED
}

/// A term, semester or seminar (docs/design/course-periods.md). AUTO opens it at starts_at.
model AcademicPeriod {
  id         String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String     @map("tenant_id") @db.Uuid
  name       String
  kind       PeriodKind @default(TERM)
  startsAt   DateTime   @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime?  @map("ends_at") @db.Timestamptz(3)
  mode       PeriodMode @default(AUTO)
  position   Int        @default(0)
  archivedAt DateTime?  @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @default(now()) @map("updated_at") @db.Timestamptz(3)

  courses Course[]

  @@unique([tenantId, id], map: "academic_period_tenant_id_id_key")
  @@index([tenantId, startsAt], map: "academic_period_tenant_starts_idx")
  @@map("academic_period")
}

model Course {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                   @map("tenant_id") @db.Uuid
  ownerMembershipId String                   @map("owner_membership_id") @db.Uuid
  subjectId         String?                  @map("subject_id") @db.Uuid
  slug              String
  title             String
  subtitle          String?
  descriptionJson   Json?                    @map("description_json")
  descriptionText   String                   @default("") @map("description_text")
  outcomes          String[]                 @default([])
  requirements      String[]                 @default([])
  level             CourseLevel              @default(ALL_LEVELS)
  language          String                   @default("en")
  tags              String[]                 @default([])
  coverAssetId      String?                  @map("cover_asset_id") @db.Uuid
  priceMinor        BigInt                   @default(0) @map("price_minor")
  currency          String                   @default("ZMW") @db.Char(3)
  accessDays        Int?                     @map("access_days")
  /// Deposit plan (docs/design/payment-plans.md): all three set, or none.
  depositMinor      BigInt?                  @map("deposit_minor")
  depositLessonPct  Int?                     @map("deposit_lesson_pct") @db.SmallInt
  balanceDueDays    Int?                     @map("balance_due_days")
  /// Course periods (docs/design/course-periods.md): null = an open course.
  periodId          String?                  @map("period_id") @db.Uuid
  /// An administrator's lock or opening of this course; wins over the period.
  accessOverride    CourseAccessOverride?    @map("access_override")
  status            CourseStatus             @default(DRAFT)
  firstPublishedAt  DateTime?                @map("first_published_at") @db.Timestamptz(3)
  publishedAt       DateTime?                @map("published_at") @db.Timestamptz(3)
  archivedAt        DateTime?                @map("archived_at") @db.Timestamptz(3)
  enrollmentCount   Int                      @default(0) @map("enrollment_count")
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(3)
  version           Int                      @default(1)
  searchVector      Unsupported("tsvector")? @map("search_vector")

  subject     Subject?           @relation(fields: [tenantId, subjectId], references: [tenantId, id], onDelete: Restrict)
  period      AcademicPeriod?    @relation(fields: [tenantId, periodId], references: [tenantId, id], onDelete: Restrict)
  sections    Section[]
  lessons     Lesson[]
  submissions CourseSubmission[]
  enrollments Enrollment[]
  questions   Question[]
  quizzes     Quiz[]
  attempts    Attempt[]
  orderItems  OrderItem[]

  @@unique([tenantId, slug], map: "course_tenant_slug_key")
  @@unique([tenantId, id], map: "course_tenant_id_id_key")
  @@index([tenantId, ownerMembershipId, status], map: "course_tenant_owner_status_idx")
  @@index([tenantId, periodId], map: "course_tenant_period_idx")
  @@map("course")
}

model CourseSubmission {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String              @map("tenant_id") @db.Uuid
  courseId          String              @map("course_id") @db.Uuid
