  version         Int        @default(1)

  course      Course             @relation(fields: [tenantId, courseId], references: [tenantId, id], onDelete: Cascade)
  section     Section            @relation(fields: [tenantId, sectionId], references: [tenantId, id], onDelete: Cascade)
  attachments LessonAttachment[]
  progress    LessonProgress[]

  @@unique([tenantId, id], map: "lesson_tenant_id_id_key")
  @@unique([tenantId, sectionId, position], map: "lesson_section_position_key")
  @@index([tenantId, courseId], map: "lesson_tenant_course_idx")
  @@map("lesson")
}

model LessonAttachment {
  tenantId String @map("tenant_id") @db.Uuid
