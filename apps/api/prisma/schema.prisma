  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime        @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@index([tenantId, period(sort: Desc)], map: "platform_statement_tenant_period_idx")
  @@map("platform_statement")
}

/// In-app notifications (F33). RLS: tenant_isolation.
model Notification {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  membershipId String    @map("membership_id") @db.Uuid
  kind         String
  title        String
  body         String?
  link         String?
  readAt       DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([tenantId, membershipId, createdAt(sort: Desc)], map: "notification_tenant_member_idx")
  @@map("notification")
}

model NotificationPreference {
  tenantId     String   @map("tenant_id") @db.Uuid
  membershipId String   @map("membership_id") @db.Uuid
  category     String
  emailEnabled Boolean  @default(true) @map("email_enabled")
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(3)

  @@id([tenantId, membershipId, category])
  @@map("notification_preference")
}

/// Archived rows of a purged school (BR-53). No runtime grants.
model TenantArchive {
  id          BigInt   @id @default(autoincrement())
  tenantId    String   @map("tenant_id") @db.Uuid
  sourceTable String   @map("source_table")
  rowData     Json     @map("row_data")
  archivedAt  DateTime @default(now()) @map("archived_at") @db.Timestamptz(3)

  @@index([tenantId, sourceTable], map: "tenant_archive_tenant_table_idx")
  @@map("tenant_archive")
}
