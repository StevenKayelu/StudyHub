{
  "name": "studyhub",
  "private": true,
  "description": "StudyHub — multi-tenant learning platform",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@studyhub/api --filter=@studyhub/web",
    "build": "turbo run build",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "turbo run typecheck",
    "boundaries": "depcruise apps packages --config .dependency-cruiser.cjs && node tools/boundary-fixtures/expect-violations.mjs",
    "test": "turbo run test",
    "test:int": "turbo run test:int",
    "test:recovery": "pnpm --filter @studyhub/api exec vitest run --config vitest.integration.config.mts test/integration/recovery-drill.int.test.ts test/integration/school-recovery.int.test.ts test/integration/object-recovery.int.test.ts test/integration/object-backup.int.test.ts",
    "test:load:smoke": "pnpm --filter @studyhub/api exec vitest run --config vitest.load.config.mts",
    "test:e2e": "pnpm --filter @studyhub/web test:e2e",
    "test:e2e:isolated": "node tools/e2e-isolated.mjs",
    "test:security": "pnpm --filter @studyhub/web test:security",
    "db:up": "docker compose --env-file .env -f infra/compose/docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose --env-file .env -f infra/compose/docker-compose.dev.yml down",
    "db:provision-roles": "node tools/db-provision-roles.mjs",
    "db:migrate": "pnpm --filter @studyhub/api db:migrate",
    "db:seed": "pnpm --filter @studyhub/api db:seed",
    "storage:bootstrap": "pnpm --filter @studyhub/api storage:bootstrap",
    "tenant:create": "pnpm --filter @studyhub/api tenant:create",
    "openapi": "pnpm --filter @studyhub/contracts build && pnpm --filter @studyhub/contracts openapi",
    "secrets:scan": "node tools/gitleaks.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm boundaries && pnpm test && pnpm test:int && pnpm build && pnpm test:security && pnpm test:e2e:isolated && pnpm test:stories && pnpm openapi && pnpm secrets:scan",
    "storybook": "pnpm --filter @studyhub/ui storybook",
    "test:stories": "pnpm --filter @studyhub/ui build-storybook && pnpm --filter @studyhub/ui test:stories"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.0",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "18.5.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "turbo": "2.11.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
