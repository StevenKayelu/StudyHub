{
  "name": "@studyhub/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared API contracts: error codes, problem+json, health schemas, OpenAPI",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "openapi": "node scripts/generate-openapi.mts"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@studyhub/config": "workspace:*",
    "vitest": "5.0.3"
  }
}
