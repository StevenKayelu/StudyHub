export function identityPaths(
  ref: (name: string) => { $ref: string },
): Record<string, Record<string, unknown>> {
  const paths: Record<string, Record<string, unknown>> = {};
  for (const op of OPS) {
    const parameters = [...op.path.matchAll(/\{(\w+)\}/g)].map(([, name]) => ({
      name,
      in: 'path',
      required: true,
      schema: { type: 'string', format: 'uuid' },
    }));
    paths[op.path] ??= {};
    paths[op.path]![op.method] = {
      operationId: op.id,
      tags: [op.tag],
      summary: op.summary,
      ...(parameters.length > 0 && { parameters }),
      ...(op.auth !== 'none' && {
        security: [{ [op.auth === 'console' ? 'consoleCookie' : 'sessionCookie']: [] }],
      }),
      ...(op.request !== undefined && {
        requestBody: { required: true, content: { 'application/json': { schema: ref(op.request) } } },
      }),
      responses: {
        [String(op.status)]: {
          description: 'Success.',
          ...(op.response !== undefined && { content: { 'application/json': { schema: ref(op.response) } } }),
        },
        '4XX': {
          description: 'Client error (problem+json with a stable code).',
          content: { [PROBLEM_CONTENT_TYPE]: { schema: ref('Problem') } },
        },
      },
    };
  }
  return paths;
}
