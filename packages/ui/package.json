{
  "name": "@studyhub/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Copperline design system: tokens, theme compiler (white-label), React components, Storybook",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "tokens": "pnpm build && node scripts/write-tokens-css.mjs",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build --output-dir storybook-static --quiet",
    "test:stories": "playwright test"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "culori": "4.0.2",
    "lucide-react": "1.55.0",
    "radix-ui": "1.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@playwright/test": "1.64.0",
    "@storybook/react-vite": "10.6.2",
    "@studyhub/config": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@types/culori": "4.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "fast-check": "4.10.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
