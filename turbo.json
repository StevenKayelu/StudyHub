{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "agentGuidance": false,
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": [
        "API_INTERNAL_URL",
        "PLATFORM_HOSTS",
        "CONSOLE_HOSTS",
        "WEB_CSP_CONNECT_ORIGINS",
        "WEB_CSP_IMAGE_ORIGINS",
        "WEB_CSP_MEDIA_ORIGINS",
        "WEB_CSP_FRAME_ORIGINS"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"]
    },
    "@studyhub/contracts#typecheck": {
      "dependsOn": ["build"]
    },
    "test": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test:int": {
      "dependsOn": ["^build", "db:generate"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build", "db:generate"],
      "env": [
        "WEB_CSP_CONNECT_ORIGINS",
        "WEB_CSP_IMAGE_ORIGINS",
        "WEB_CSP_MEDIA_ORIGINS",
        "WEB_CSP_FRAME_ORIGINS",
        "MAINTENANCE_MODE"
      ],
      "cache": false,
      "persistent": true
    }
  }
}
